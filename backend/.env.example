APP_NAME="Desa Selorejo API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# ============================
# Database: Supabase PostgreSQL
# ============================
# Dapatkan dari: https://app.supabase.com → Project Settings → Database
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password

# ============================
# Supabase (untuk Storage & Auth)
# ============================
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ============================
# CORS (Frontend URL)
# ============================
FRONTEND_URL=http://localhost:3000

# ============================
# Cache & Session
# ============================
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ============================
# Queue & Log
# ============================
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ============================
# Mail (opsional)
# ============================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@desaselorejo.id"
MAIL_FROM_NAME="${APP_NAME}"

# ============================
# Filesystem
# ============================
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================
# Broadcasting
# ============================
BROADCAST_CONNECTION=log
